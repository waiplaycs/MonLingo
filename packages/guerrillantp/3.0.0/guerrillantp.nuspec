<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>GuerrillaNtp</id>
    <version>3.0.0</version>
    <title>GuerrillaNtp</title>
    <authors>robertvazan</authors>
    <license type="expression">Apache-2.0</license>
    <licenseUrl>https://licenses.nuget.org/Apache-2.0</licenseUrl>
    <icon>icon.png</icon>
    <projectUrl>https://guerrillantp.machinezoo.com/</projectUrl>
    <description>Simple NTP (SNTP) client that can be embedded in desktop applications to provide accurate network time even when the system clock is unsynchronized.</description>
    <tags>NTP SNTP time clock network</tags>
    <readme>README.md</readme>
    <repository url="https://github.com/robertvazan/guerrillantp.git" />
    <dependencies>
      <group targetFramework="net5.0" />
    </dependencies>
  </metadata>
</package>