<Window x:Class="MonLingo.View.Windows.SettingMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MonLingo 設置" Height="720" Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#FBFCFE"
        WindowStyle="SingleBorderWindow">
    
    <Window.Resources>
        <!-- macOS風格側邊欄按鈕樣式 -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#424752"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Margin="8,1">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS風格側邊欄選中按鈕樣式 -->
        <Style x:Key="SidebarButtonSelectedStyle" TargetType="Button">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="#4F46E5" 
                                CornerRadius="6" 
                                Margin="8,1">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <!-- 選中狀態下不響應鼠標懸浮，保持藍紫色 -->
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS風格設置卡片樣式 -->
        <Style x:Key="SettingCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#00000000" Direction="270" ShadowDepth="0" BlurRadius="0" Opacity="0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- macOS風格標題樣式 -->
        <Style x:Key="SettingTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- macOS風格子標題樣式 -->
        <Style x:Key="SettingSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- macOS風格下拉框樣式 -->
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Focusable="False"
                                            IsChecked="{Binding Path=IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                            ClickMode="Press"/>
                                <ContentPresenter x:Name="ContentSite"
                                                IsHitTestVisible="False"
                                                Content="{TemplateBinding SelectionBoxItem}"
                                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                Margin="{TemplateBinding Padding}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left"/>
                                <Path x:Name="Arrow"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0"
                                    Fill="#6B7280"
                                    Data="M7 10L12 15L17 10H7Z"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#9CA3AF"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4F46E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS風格切換開關樣式 -->
        <Style x:Key="ModernToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border" 
                                Background="#D1D5DB" 
                                CornerRadius="14"
                                Width="48" Height="28">
                            <Ellipse x:Name="Thumb" 
                                     Fill="White" 
                                     Width="24" Height="24"
                                     HorizontalAlignment="Left" 
                                     Margin="2,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" BlurRadius="2" Opacity="0.2"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#4F46E5"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS風格重置按鈕樣式 -->
        <Style x:Key="ResetButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#3730A3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#312E81"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左側導航欄 - macOS風格 -->
        <Border Grid.Column="0" 
                Background="#F8F9FA" 
                BorderBrush="#E5E7EB" 
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 標題區域 - macOS風格漸變 -->
                <Border Grid.Row="0" Padding="20,24,20,20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#4F46E5" Offset="0"/>
                            <GradientStop Color="#3730A3" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="MonLingo" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Foreground="White"/>
                        <TextBlock Text="應用程式設置" 
                                   FontSize="12" 
                                   Foreground="#C7D2FE" 
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 滾動的導航選項 - macOS風格分組 -->
                <ScrollViewer Grid.Row="1" 
                              VerticalScrollBarVisibility="Auto" 
                              Margin="0,16,0,0"
                              Padding="0,0,0,16">
                    <StackPanel>
                    <!-- 功能分類 -->
                    <TextBlock Text="功能" FontSize="12" FontWeight="SemiBold" Foreground="#9CA3AF" 
                               Margin="20,0,20,10"/>
                    
                    <Button Style="{StaticResource SidebarButtonStyle}" Tag="翻譯語言" Click="NavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌏" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="翻譯語言"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Style="{StaticResource SidebarButtonStyle}" Tag="全局設置" Click="NavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="全局設置"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Style="{StaticResource SidebarButtonStyle}" Tag="翻譯設置" Click="NavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="�" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="翻譯設置"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Style="{StaticResource SidebarButtonStyle}" Tag="顯示設置" Click="NavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="�" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="顯示設置"/>
                        </StackPanel>
                    </Button>

                    <!-- 個人分類 -->
                    <TextBlock Text="個人" FontSize="12" FontWeight="SemiBold" Foreground="#9CA3AF" 
                               Margin="20,30,20,10"/>
                    
                    <Button Style="{StaticResource SidebarButtonStyle}" Tag="個人賬號" Click="NavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="個人賬號"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Style="{StaticResource SidebarButtonStyle}" Tag="會員" Click="NavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="�" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="會員"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Style="{StaticResource SidebarButtonStyle}" Tag="硬幣" Click="NavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🪙" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="硬幣"/>
                        </StackPanel>
                    </Button>

                    <!-- 更多分類 -->
                    <TextBlock Text="更多" FontSize="12" FontWeight="SemiBold" Foreground="#9CA3AF" 
                               Margin="20,30,20,10"/>
                    
                    <Button Style="{StaticResource SidebarButtonStyle}" Tag="快捷鍵" Click="NavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌨️" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="快捷鍵"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Style="{StaticResource SidebarButtonStyle}" Tag="聯繫官方" Click="NavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="�" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="聯繫官方"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Style="{StaticResource SidebarButtonStyle}" Tag="幫助中心" Click="NavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="❓" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="幫助中心"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Style="{StaticResource SidebarButtonStyle}" Tag="關於我們" Click="NavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ℹ️" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="關於我們"/>
                        </StackPanel>
                    </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 右側內容區 - macOS風格 -->
        <Border Grid.Column="1" Background="#FBFCFE">
            <ScrollViewer Padding="32,24,32,32" 
                          Name="ContentScrollViewer"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Name="ContentPanel" MaxWidth="600">
                    <!-- 動態內容將在此處顯示 -->
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- macOS風格關閉/重置按鈕 -->
        <StackPanel Grid.Column="1" 
                    Orientation="Horizontal"
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Top" 
                    Margin="0,16,16,0">
            <!-- 關閉按鈕 -->
            <Button Width="24" Height="24" 
                    Margin="0,0,8,0"
                    Background="#FF5F57" 
                    BorderThickness="0" 
                    ToolTip="關閉設置"
                    Click="CloseButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <Path x:Name="CloseIcon"
                                  Data="M6 6L18 18M6 18L18 6"
                                  Stroke="White"
                                  StrokeThickness="2"
                                  Width="12" Height="12"
                                  Stretch="Uniform"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E04943"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            
            <!-- 重置按鈕 -->
            <Button Width="24" Height="24" 
                    Background="#4F46E5" 
                    BorderThickness="0" 
                    ToolTip="重置所有設定"
                    Click="ResetButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <Path x:Name="ResetIcon"
                                  Data="M1 4V10H7M23 20V14H17M20.49 9A9 9 0 0 0 5.64 5.64L1 10M22.8 14.36A9 9 0 0 1 8.51 18.85L17 14"
                                  Stroke="White"
                                  StrokeThickness="2"
                                  Width="12" Height="12"
                                  Stretch="Uniform"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#3730A3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
