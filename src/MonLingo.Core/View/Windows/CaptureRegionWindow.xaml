<Window x:Class="MonLingo.View.Windows.CaptureRegionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="選擇翻譯區域" 
        WindowStyle="None" 
        WindowState="Maximized"
        AllowsTransparency="True" 
        Background="#40000000"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">

    <Grid>
        <!-- 主Canvas用於繪製選擇區域 -->
        <Canvas Name="MainCanvas" Background="Transparent">
            
            <!-- 指示文字 -->
            <TextBlock Text="拖曳滑鼠選擇翻譯區域，按 ESC 取消"
                      Foreground="White"
                      FontSize="18"
                      FontWeight="SemiBold"
                      HorizontalAlignment="Center"
                      Canvas.Left="50"
                      Canvas.Top="50">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" Opacity="0.8"/>
                </TextBlock.Effect>
            </TextBlock>

            <!-- 座標顯示 -->
            <Border Name="CoordinateDisplay"
                   Background="#CC000000"
                   CornerRadius="4"
                   Padding="8,4"
                   Canvas.Right="20"
                   Canvas.Top="20"
                   Visibility="{Binding IsSelecting, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Foreground="White" FontSize="12">
                        <Run Text="起始: "/>
                        <Run Text="{Binding StartPoint, StringFormat='({0:F0}, {1:F0})'}"/>
                    </TextBlock>
                    <TextBlock Foreground="White" FontSize="12">
                        <Run Text="當前: "/>
                        <Run Text="{Binding CurrentPoint, StringFormat='({0:F0}, {1:F0})'}"/>
                    </TextBlock>
                    <TextBlock Foreground="White" FontSize="12">
                        <Run Text="大小: "/>
                        <Run Text="{Binding SelectionSize, StringFormat='{}{0:F0} × {1:F0}'}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 快捷鍵說明 -->
            <Border Background="#CC1E1E1E"
                   CornerRadius="6"
                   Padding="12,8"
                   Canvas.Left="20"
                   Canvas.Bottom="20">
                <StackPanel>
                    <TextBlock Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,4">
                        快捷鍵說明
                    </TextBlock>
                    <TextBlock Foreground="#FFCCCCCC" FontSize="12">
                        <Run Text="• 拖曳滑鼠選擇區域"/>
                    </TextBlock>
                    <TextBlock Foreground="#FFCCCCCC" FontSize="12">
                        <Run Text="• ESC 取消選擇"/>
                    </TextBlock>
                    <TextBlock Foreground="#FFCCCCCC" FontSize="12">
                        <Run Text="• 鬆開滑鼠完成選擇"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 十字準線（可選） -->
            <Line Name="VerticalLine" 
                  Stroke="Red" 
                  StrokeThickness="1" 
                  Opacity="0.6"
                  X1="0" Y1="0" X2="0" Y2="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}"
                  Visibility="Collapsed"/>
            
            <Line Name="HorizontalLine" 
                  Stroke="Red" 
                  StrokeThickness="1" 
                  Opacity="0.6"
                  X1="0" Y1="0" X2="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}" Y2="0"
                  Visibility="Collapsed"/>
        </Canvas>
    </Grid>
</Window>
