<Window x:Class="MonLingo.Core.View.Windows.TranslationResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TranslationResultWindow" 
        Width="400" Height="200"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MouseDown="OnWindowMouseDown">
    
    <Border CornerRadius="10" Background="#E6000000" BorderBrush="#FF333333" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="5" Opacity="0.5" BlurRadius="10"/>
        </Border.Effect>
        
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 關閉按鈕 -->
            <Button Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="20" Height="20" Content="✕" 
                    Background="Transparent" BorderThickness="0"
                    Foreground="#FFAAAAAA" FontSize="12"
                    Click="OnCloseButtonClick"
                    Margin="0,-5,-5,5">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#33FF0000"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <!-- 原文區域 -->
            <StackPanel Grid.Row="1" Margin="0,10,0,5">
                <TextBlock Text="原文:" Foreground="#FFAAAAAA" FontSize="12" Margin="0,0,0,5"/>
                <ScrollViewer MaxHeight="60" VerticalScrollBarVisibility="Auto">
                    <TextBlock Name="OriginalTextBlock" 
                               Foreground="White" 
                               FontSize="13" 
                               TextWrapping="Wrap"
                               LineHeight="18"/>
                </ScrollViewer>
            </StackPanel>

            <!-- 翻譯區域 -->
            <StackPanel Grid.Row="2" Margin="0,5,0,10">
                <TextBlock Text="翻譯:" Foreground="#FFAAAAAA" FontSize="12" Margin="0,0,0,5"/>
                <ScrollViewer MaxHeight="60" VerticalScrollBarVisibility="Auto">
                    <TextBlock Name="TranslatedTextBlock" 
                               Foreground="#FF87CEEB" 
                               FontSize="14" 
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               LineHeight="20"/>
                </ScrollViewer>
            </StackPanel>

            <!-- 操作按鈕 -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                <Button Content="複製原文" Width="80" Height="25" Margin="5,0"
                        Background="#FF333333" Foreground="White" BorderThickness="1" BorderBrush="#FF555555"
                        Click="OnCopyOriginalClick">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FF555555"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                
                <Button Content="複製翻譯" Width="80" Height="25" Margin="5,0"
                        Background="#FF0078D4" Foreground="White" BorderThickness="0"
                        Click="OnCopyTranslationClick">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FF106EBE"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <!-- 反饋訊息 -->
            <TextBlock Grid.Row="4" Name="FeedbackTextBlock" 
                       Text="已複製" 
                       Foreground="#FF90EE90" 
                       FontSize="11" 
                       HorizontalAlignment="Center"
                       Visibility="Collapsed"
                       Margin="0,5,0,0"/>
        </Grid>
    </Border>
</Window>
