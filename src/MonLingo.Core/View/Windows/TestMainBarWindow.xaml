<Window x:Class="MonLingo.View.Windows.TestMainBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MonLingo 測試工具列" 
        Height="52" Width="1050"
        AllowsTransparency="False" 
        WindowStyle="None" 
        Background="Gray"
        WindowStartupLocation="Manual"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="NoResize">

    <Grid Background="DarkGray">
        <TextBlock Text="MonLingo 測試工具列" 
                   Foreground="White" 
                   FontSize="16" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"/>
        
        <Button Content="測試按鈕" 
                Width="100" 
                Height="30" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Center"
                Margin="10"
                Click="TestButton_Click"/>
    </Grid>
</Window>
