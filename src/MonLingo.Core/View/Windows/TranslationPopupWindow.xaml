<Window x:Class="MonLingo.View.Windows.TranslationPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="翻譯結果" 
        Width="400" Height="200"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- 按鈕樣式 -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#20FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 載入動畫樣式 -->
        <Style x:Key="LoadingStyle" TargetType="Ellipse">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTranslating}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                               From="0" To="360" Duration="0:0:1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- 主容器 -->
    <Border Name="MainBorder" 
            Background="#F0FFFFFF" 
            CornerRadius="8" 
            BorderThickness="1" 
            BorderBrush="#DDD">
        <Border.Effect>
            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" Opacity="0.3" BlurRadius="8"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 標題列 -->
            <Border Grid.Row="0" 
                    Background="#FF2D2D30" 
                    CornerRadius="8,8,0,0"
                    Height="32">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 圖示 -->
                    <Path Grid.Column="0" 
                          Data="M12.87,15.07L10.33,12.56L10.36,12.53C12.1,10.59 13.34,8.36 14.07,6H17V4H10V2H8V4H1V6H12.17C11.5,7.92 10.44,9.75 9,11.35C8.07,10.32 7.3,9.19 6.69,8H4.69C5.42,9.63 6.42,11.17 7.67,12.56L2.58,17.58L4,19L9,14L12.11,17.11L12.87,15.07Z" 
                          Fill="White" 
                          Width="16" Height="16" 
                          Stretch="Fill" 
                          VerticalAlignment="Center"
                          Margin="8,0,0,0"/>

                    <!-- 標題 -->
                    <TextBlock Grid.Column="1" 
                               Text="翻譯結果" 
                               Foreground="White" 
                               FontSize="12" 
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" 
                               Margin="8,0,0,0"/>

                    <!-- 控制按鈕 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,4,0">
                        <!-- 複製按鈕 -->
                        <Button Style="{StaticResource IconButtonStyle}"
                                Command="{Binding CopyCommand}"
                                ToolTip="複製翻譯結果">
                            <Path Data="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z" 
                                  Fill="White" Width="12" Height="12" Stretch="Fill"/>
                        </Button>

                        <!-- 關閉按鈕 -->
                        <Button Style="{StaticResource IconButtonStyle}"
                                Command="{Binding CloseCommand}"
                                ToolTip="關閉">
                            <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" 
                                  Fill="White" Width="12" Height="12" Stretch="Fill"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 內容區域 -->
            <Grid Grid.Row="1" Margin="12">
                <!-- 載入中狀態 -->
                <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           Visibility="{Binding IsTranslating, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Ellipse Width="16" Height="16" 
                            Fill="#FF2D2D30" 
                            Style="{StaticResource LoadingStyle}">
                        <Ellipse.RenderTransform>
                            <RotateTransform/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}" 
                              FontSize="14" 
                              Margin="8,0,0,0" 
                              VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 翻譯結果 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                             Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <!-- 原文 -->
                        <TextBlock Text="原文:" 
                                  FontSize="12" 
                                  Foreground="#666" 
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,4"/>
                        <Border Background="#F8F8F8" 
                               CornerRadius="4" 
                               Padding="8" 
                               Margin="0,0,0,8">
                            <TextBlock Text="{Binding OriginalText}" 
                                      FontSize="13" 
                                      TextWrapping="Wrap"
                                      Foreground="#333"/>
                        </Border>

                        <!-- 譯文 -->
                        <TextBlock Text="譯文:" 
                                  FontSize="12" 
                                  Foreground="#666" 
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,4"/>
                        <Border Background="#E8F5E8" 
                               CornerRadius="4" 
                               Padding="8">
                            <TextBlock Text="{Binding TranslatedText}" 
                                      FontSize="14" 
                                      FontWeight="SemiBold"
                                      TextWrapping="Wrap"
                                      Foreground="#2D5016"/>
                        </Border>

                        <!-- 語言資訊 -->
                        <TextBlock Margin="0,8,0,0" 
                                  FontSize="11" 
                                  Foreground="#999">
                            <Run Text="檢測語言: "/>
                            <Run Text="{Binding DetectedLanguage}" FontWeight="SemiBold"/>
                            <Run Text=" → "/>
                            <Run Text="{Binding TargetLanguage}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>

                <!-- 錯誤狀態 -->
                <StackPanel HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Path Data="M12,2L13.09,8.26L22,9L17,14L18.18,23L12,19.77L5.82,23L7,14L2,9L10.91,8.26L12,2Z" 
                          Fill="#FF6B6B" 
                          Width="24" Height="24" 
                          Stretch="Fill"
                          HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ErrorMessage}" 
                              FontSize="12" 
                              Foreground="#FF6B6B" 
                              TextWrapping="Wrap"
                              TextAlignment="Center"
                              Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>

            <!-- 狀態列 -->
            <Border Grid.Row="2" 
                    Background="#F5F5F5" 
                    CornerRadius="0,0,8,8"
                    Height="24"
                    Visibility="{Binding ShowStatusBar, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 狀態文字 -->
                    <TextBlock Grid.Column="0" 
                              Text="{Binding StatusText}" 
                              FontSize="10" 
                              Foreground="#666" 
                              VerticalAlignment="Center"
                              Margin="8,0,0,0"/>

                    <!-- 處理時間 -->
                    <TextBlock Grid.Column="1" 
                              FontSize="10" 
                              Foreground="#999" 
                              VerticalAlignment="Center"
                              Margin="0,0,8,0">
                        <Run Text="耗時: "/>
                        <Run Text="{Binding ProcessingTime, StringFormat='{}{0:F1}s'}"/>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
