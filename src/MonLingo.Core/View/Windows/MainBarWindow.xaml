<Window x:Class="MonLingo.View.Windows.MainBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MonLingo 翻譯工具列" 
        Height="52" Width="1050"
        AllowsTransparency="True" 
        WindowStyle="None" 
        Background="Transparent"
        WindowStartupLocation="Manual"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- 定義所有 Lucide 圖示的向量路徑數據 -->
        <Geometry x:Key="IconPlay">M6 4L20 12L6 20V4Z</Geometry>
        <Geometry x:Key="IconCrown">M2 4L6 14L12 6L18 14L22 4</Geometry>
        <Geometry x:Key="IconCoins">M10 4H14V6H10V4M12 2A10 10 0 0 0 2 12A10 10 0 0 0 12 22A10 10 0 0 0 22 12A10 10 0 0 0 12 2M12 7A5 5 0 0 1 17 12C17 14.19 15.64 16.05 13.8 16.68L13.1 14.9C14.18 14.53 15 13.38 15 12A3 3 0 0 0 12 9A3 3 0 0 0 9 12C9 13.38 9.82 14.53 10.9 14.9L10.2 16.68C8.36 16.05 7 14.19 7 12A5 5 0 0 1 12 7Z</Geometry>
        <Geometry x:Key="IconChevronDown">M6 9L12 15L18 9</Geometry>
        <Geometry x:Key="IconGitCompare">M18 18H6V6H18V18ZM6 4H18C19.1 4 20 4.9 20 6V18C20 19.1 19.1 20 18 20H6C4.9 20 4 19.1 4 18V6C4 4.9 4.9 4 6 4ZM11 15V9H9V7H11V9H13V7H15V9H13V15H11Z</Geometry>
        <Geometry x:Key="IconArrowRight">M5 12H19M12 5L19 12L12 19</Geometry>
        <Geometry x:Key="IconBookOpen">M2 3H8V21H2V3M22 3H16V21H22V3M14 5V19H10V5H14Z</Geometry>
        <Geometry x:Key="IconCamera">M20 6H16L14.5 4H9.5L8 6H4C2.9 6 2 6.9 2 8V18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V8C22 6.9 21.1 6 20 6ZM12 17C9.24 17 7 14.76 7 12C7 9.24 9.24 7 12 7C14.76 7 17 9.24 17 12C17 14.76 14.76 17 12 17Z</Geometry>
        <Geometry x:Key="IconSquare">M3 3H21V21H3V3Z</Geometry>
        <Geometry x:Key="IconSquareDot">M3 3H21V21H3V3M12 12A1 1 0 1 0 12 14A1 1 0 0 0 12 12Z</Geometry>
        <Geometry x:Key="IconPalette">M12 21.35L1.65 11L12 1.65L22.35 11L12 21.35ZM12 4.33L4.33 12L12 19.67L19.67 12L12 4.33Z</Geometry>
        <Geometry x:Key="IconEdit3">M12 20H21M16.5 3.5A2.121 2.121 0 0 1 19.5 6.5L7 19L3 20L4 16L16.5 3.5Z</Geometry>
        <Geometry x:Key="IconMoreHorizontal">M4 12H4M12 12H12M20 12H20</Geometry>
        <Geometry x:Key="IconSettings">M12 15.5A3.5 3.5 0 0 1 8.5 12A3.5 3.5 0 0 1 12 8.5A3.5 3.5 0 0 1 15.5 12A3.5 3.5 0 0 1 12 15.5M19.43 12.97C19.47 12.65 19.5 12.33 19.5 12C19.5 11.67 19.47 11.34 19.43 11.03L21.7 9.39L20.27 6.9L17.9 7.87C17.36 7.45 16.76 7.1 16.1 6.83L15.64 4H12.37L11.9 6.83C11.24 7.1 10.64 7.45 10.1 7.87L7.73 6.9L6.3 9.39L8.57 11.03C8.53 11.35 8.5 11.67 8.5 12C8.5 12.33 8.53 12.65 8.57 12.97L6.3 14.61L7.73 17.1L10.1 16.13C10.64 16.55 11.24 16.9 11.9 17.17L12.36 20H15.64L16.1 17.17C16.76 16.9 17.36 16.55 17.9 16.13L20.27 17.1L21.7 14.61L19.43 12.97Z</Geometry>
        <Geometry x:Key="IconMinus">M5 12H19</Geometry>
        <Geometry x:Key="IconChevronUp">M18 15L12 9L6 15</Geometry>
        <Geometry x:Key="IconMove">M9 18V5L4 10M15 5V18L20 13</Geometry>
        <Geometry x:Key="IconX">M18 6L6 18M6 6L18 18</Geometry>

        <!-- 通用圖示按鈕樣式 -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="999">
                            <Path Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" 
                                  Fill="{TemplateBinding Foreground}" 
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.5"
                                  Width="16" 
                                  Height="16" 
                                  Stretch="Uniform"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 移動按鈕樣式 -->
        <Style x:Key="MoveButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Cursor" Value="SizeAll"/>
        </Style>

        <!-- 自定義滑動開關樣式 -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="BackgroundBorder" Background="#FF4B5563" CornerRadius="8" Width="32" Height="16" VerticalAlignment="Center"/>
                            <Border x:Name="Dot" Background="White" CornerRadius="6" Width="12" Height="12" HorizontalAlignment="Left" Margin="2,0">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="DotTransform"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="DotTransform" Storyboard.TargetProperty="X" To="16" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="DotTransform" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- 主容器，使用 Border 實現圓角、邊框和背景 -->
    <Border CornerRadius="26" BorderThickness="1" BorderBrush="#44888888" Padding="12,8">
        <Border.Background>
            <SolidColorBrush Color="Black" Opacity="0.9"/>
        </Border.Background>
        <Border.Effect>
            <BlurEffect Radius="1"/>
        </Border.Effect>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

            <!-- 1. 開始翻譯按鈕 -->
            <Button x:Name="StartTranslateButton" 
                    Style="{StaticResource IconButton}" 
                    Tag="{StaticResource IconPlay}" 
                    Command="{Binding StartTranslationCommand}">
                <Button.RenderTransform>
                    <RotateTransform CenterX="14" CenterY="14"/>
                </Button.RenderTransform>
            </Button>

            <!-- 2. 會員狀態 -->
            <Border CornerRadius="999" Padding="8,4" Margin="8,0,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FBBF24" Offset="0.0" />
                        <GradientStop Color="#F59E0B" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconCrown}" Fill="Black" Width="12" Height="12" VerticalAlignment="Center"/>
                    <TextBlock Text="PRO" Foreground="Black" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0" FontSize="10"/>
                </StackPanel>
            </Border>

            <!-- 3. 今日剩餘翻譯點數 -->
            <TextBlock Text="{Binding RemainingTranslations}" 
                       Foreground="#93C5FD" 
                       FontSize="16" 
                       FontWeight="Medium" 
                       VerticalAlignment="Center" 
                       Margin="8,0,0,0"/>

            <!-- 4. 硬幣餘額 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <Path Data="{StaticResource IconCoins}" Fill="#FBBF24" Width="12" Height="12" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding CoinBalance}" 
                           Foreground="White" 
                           FontSize="11" 
                           VerticalAlignment="Center" 
                           Margin="4,0,0,0"/>
            </StackPanel>

            <!-- 分隔線 -->
            <Rectangle Fill="#44888888" Width="1" Height="16" Margin="12,0"/>

            <!-- 5. 翻譯引擎選擇 -->
            <Border Background="#80000000" CornerRadius="999" Padding="8,4">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Fill="#4ADE80" Width="8" Height="8"/>
                    <TextBlock Text="{Binding SelectedEngine}" 
                               Foreground="White" 
                               FontSize="11" 
                               Margin="8,0,4,0"/>
                    <Path Data="{StaticResource IconChevronDown}" 
                          Stroke="White" 
                          StrokeThickness="1.5" 
                          Width="12" 
                          Height="12"/>
                </StackPanel>
            </Border>

            <!-- 6. 翻譯引擎對比 -->
            <Button Style="{StaticResource IconButton}" 
                    Tag="{StaticResource IconGitCompare}" 
                    Margin="4,0,0,0"
                    Command="{Binding CompareEnginesCommand}"/>

            <!-- 7. 翻譯語言 -->
            <Border Background="#80000000" CornerRadius="999" Padding="8,4" Margin="4,0,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SourceLanguage}" 
                               Foreground="White" 
                               FontSize="11"/>
                    <Path Data="{StaticResource IconArrowRight}" 
                          Stroke="White" 
                          StrokeThickness="1.5" 
                          Width="12" 
                          Height="12" 
                          Margin="4,0"/>
                    <TextBlock Text="{Binding TargetLanguage}" 
                               Foreground="White" 
                               FontSize="11"/>
                </StackPanel>
            </Border>

            <!-- 8. 自定義詞典 -->
            <Button Style="{StaticResource IconButton}" 
                    Tag="{StaticResource IconBookOpen}" 
                    Margin="4,0,0,0"
                    Command="{Binding OpenDictionaryCommand}"/>

            <!-- 9. 快速截圖翻譯 -->
            <Button Style="{StaticResource IconButton}" 
                    Tag="{StaticResource IconCamera}" 
                    Margin="4,0,0,0"
                    Command="{Binding QuickScreenshotCommand}"/>

            <!-- 分隔線 -->
            <Rectangle Fill="#44888888" Width="1" Height="16" Margin="12,0"/>

            <!-- 10. 翻譯區域選擇 -->
            <Button Style="{StaticResource IconButton}" 
                    Tag="{StaticResource IconSquare}"
                    Command="{Binding SelectRegionCommand}"/>
            <!-- 11. 翻譯區域2選擇 -->
            <Button Style="{StaticResource IconButton}" 
                    Tag="{StaticResource IconSquareDot}"
                    Command="{Binding SelectRegion2Command}"/>
            <!-- 12. 漫畫翻譯優化 -->
            <Button Style="{StaticResource IconButton}" 
                    Tag="{StaticResource IconPalette}"
                    Command="{Binding ComicModeCommand}"/>

            <!-- 分隔線 -->
            <Rectangle Fill="#44888888" Width="1" Height="16" Margin="12,0"/>

            <!-- 13. 覆蓋模式切換 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Style="{StaticResource ToggleSwitchStyle}" 
                          IsChecked="{Binding IsCoverModeEnabled}" 
                          Tag="#3B82F6"/>
                <TextBlock Text="COVER" Foreground="White" FontSize="10" Margin="4,0,0,0"/>
            </StackPanel>

            <!-- 14. 自動翻譯開關 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <CheckBox Style="{StaticResource ToggleSwitchStyle}" 
                          IsChecked="{Binding IsAutoTranslateEnabled}" 
                          Tag="#22C55E"/>
                <TextBlock Text="AUTO" Foreground="White" FontSize="10" Margin="4,0,0,0"/>
            </StackPanel>

            <!-- 分隔線 -->
            <Rectangle Fill="#44888888" Width="1" Height="16" Margin="12,0"/>

            <!-- 15. 編輯窗口 -->
            <Button Style="{StaticResource IconButton}" 
                    Tag="{StaticResource IconEdit3}"
                    Command="{Binding OpenEditorCommand}"/>
            <!-- 16. 更多工具 -->
            <Button Style="{StaticResource IconButton}" 
                    Tag="{StaticResource IconMoreHorizontal}"
                    Command="{Binding ShowMoreToolsCommand}"/>
            <!-- 17. 設置 -->
            <Button Style="{StaticResource IconButton}" 
                    Tag="{StaticResource IconSettings}"
                    Command="{Binding OpenSettingsCommand}"/>

            <!-- 分隔線 -->
            <Rectangle Fill="#44888888" Width="1" Height="16" Margin="12,0"/>

            <!-- 18. 最小化 -->
            <Button x:Name="MinimizeButton" 
                    Style="{StaticResource IconButton}" 
                    Tag="{StaticResource IconMinus}" 
                    Command="{Binding MinimizeCommand}"/>
            <!-- 19. 關閉 -->
            <Button x:Name="CloseButton" 
                    Style="{StaticResource IconButton}" 
                    Tag="{StaticResource IconX}" 
                    Command="{Binding ExitCommand}"/>
            <!-- 20. 收縮工具條 -->
            <Button Style="{StaticResource IconButton}" 
                    Tag="{StaticResource IconChevronUp}"
                    Command="{Binding CollapseCommand}"/>
            <!-- 21. 移動工具條 -->
            <Button Style="{StaticResource MoveButton}" 
                    Tag="{StaticResource IconMove}" 
                    MouseLeftButtonDown="MoveButton_MouseLeftButtonDown"/>

        </StackPanel>
    </Border>
</Window>
