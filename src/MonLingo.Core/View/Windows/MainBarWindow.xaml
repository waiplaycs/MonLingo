<Window x:Class="MonLingo.Core.View.Windows.MainBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MonLingo 翻譯工具列" 
        Height="44" Width="1000"
        AllowsTransparency="True" 
        WindowStyle="None" 
        Background="Transparent"
        WindowStartupLocation="Manual"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- 定義所有 Lucide 圖示的向量路徑數據 -->
        <Geometry x:Key="IconPlay">M6 4L20 12L6 20V4Z</Geometry>
        <Geometry x:Key="IconCrown">M2 4L6 14L12 6L18 14L22 4</Geometry>
        <Geometry x:Key="IconCoins">M10 4H14V6H10V4M12 2A10 10 0 0 0 2 12A10 10 0 0 0 12 22A10 10 0 0 0 22 12A10 10 0 0 0 12 2M12 7A5 5 0 0 1 17 12C17 14.19 15.64 16.05 13.8 16.68L13.1 14.9C14.18 14.53 15 13.38 15 12A3 3 0 0 0 12 9A3 3 0 0 0 9 12C9 13.38 9.82 14.53 10.9 14.9L10.2 16.68C8.36 16.05 7 14.19 7 12A5 5 0 0 1 12 7Z</Geometry>
        <Geometry x:Key="IconChevronDown">M6 9L12 15L18 9</Geometry>
        <Geometry x:Key="IconGitCompare">M18 18H6V6H18V18ZM6 4H18C19.1 4 20 4.9 20 6V18C20 19.1 19.1 20 18 20H6C4.9 20 4 19.1 4 18V6C4 4.9 4.9 4 6 4ZM11 15V9H9V7H11V9H13V7H15V9H13V15H11Z</Geometry>
        <Geometry x:Key="IconArrowRight">M5 12H19M12 5L19 12L12 19</Geometry>
        <Geometry x:Key="IconBookOpen">M2 3H8V21H2V3M22 3H16V21H22V3M14 5V19H10V5H14Z</Geometry>
        <Geometry x:Key="IconCamera">M20 6H16L14.5 4H9.5L8 6H4C2.9 6 2 6.9 2 8V18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V8C22 6.9 21.1 6 20 6ZM12 17C9.24 17 7 14.76 7 12C7 9.24 9.24 7 12 7C14.76 7 17 9.24 17 12C17 14.76 14.76 17 12 17Z</Geometry>
        <Geometry x:Key="IconSquare">M3 3H21V21H3V3Z</Geometry>
        <Geometry x:Key="IconSquareDot">M3 3H21V21H3V3M12 12A1 1 0 1 0 12 14A1 1 0 0 0 12 12Z</Geometry>
        <Geometry x:Key="IconPalette">M12 21.35L1.65 11L12 1.65L22.35 11L12 21.35ZM12 4.33L4.33 12L12 19.67L19.67 12L12 4.33Z</Geometry>
        <Geometry x:Key="IconEdit3">M12 20H21M16.5 3.5A2.121 2.121 0 0 1 19.5 6.5L7 19L3 20L4 16L16.5 3.5Z</Geometry>
        <Geometry x:Key="IconMoreHorizontal">M4 12H4M12 12H12M20 12H20</Geometry>
        <Geometry x:Key="IconSettings">M12 15.5A3.5 3.5 0 0 1 8.5 12A3.5 3.5 0 0 1 12 8.5A3.5 3.5 0 0 1 15.5 12A3.5 3.5 0 0 1 12 15.5M19.43 12.97C19.47 12.65 19.5 12.33 19.5 12C19.5 11.67 19.47 11.34 19.43 11.03L21.7 9.39L20.27 6.9L17.9 7.87C17.36 7.45 16.76 7.1 16.1 6.83L15.64 4H12.37L11.9 6.83C11.24 7.1 10.64 7.45 10.1 7.87L7.73 6.9L6.3 9.39L8.57 11.03C8.53 11.35 8.5 11.67 8.5 12C8.5 12.33 8.53 12.65 8.57 12.97L6.3 14.61L7.73 17.1L10.1 16.13C10.64 16.55 11.24 16.9 11.9 17.17L12.36 20H15.64L16.1 17.17C16.76 16.9 17.36 16.55 17.9 16.13L20.27 17.1L21.7 14.61L19.43 12.97Z</Geometry>
        <Geometry x:Key="IconMinus">M5 12H19</Geometry>
        <Geometry x:Key="IconChevronUp">M18 15L12 9L6 15</Geometry>
        <Geometry x:Key="IconChevronLeft">M15 18L9 12L15 6</Geometry>
        <Geometry x:Key="IconChevronRight">M9 18L15 12L9 6</Geometry>
        <Geometry x:Key="IconChevronsLeft">M11 17L5 12L11 7M18 17L12 12L18 7</Geometry>
        <Geometry x:Key="IconChevronsRight">M13 17L19 12L13 7M6 17L12 12L6 7</Geometry>
        <Geometry x:Key="IconMove">M13 7L9 3L5 7M9 21V3M15 7L19 3L23 7M21 21V3</Geometry>
        <Geometry x:Key="IconGripVertical">M9 5H7V3H9V5M9 11H7V9H9V11M9 17H7V15H9V17M9 23H7V21H9V23M15 5H17V3H15V5M15 11H17V9H15V11M15 17H17V15H15V17M15 23H17V21H15V23</Geometry>
        <Geometry x:Key="IconX">M18 6L6 18M6 6L18 18</Geometry>

        <!-- 引擎下拉選單樣式：深色、圓角、陰影、開闔動畫 -->
        <Style x:Key="EngineContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="MinWidth" Value="260"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border x:Name="CmBorder"
                                Background="#191919"
                                BorderBrush="#44888888"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="6"
                                Opacity="0"
                                RenderTransformOrigin="0.5,0">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="0" Opacity="0.6"/>
                            </Border.Effect>
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="CmScale" ScaleX="0.98" ScaleY="0.98"/>
                                    <TranslateTransform x:Name="CmTrans" Y="6"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsOpen" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CmBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CmScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CmScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CmTrans" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CmBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseIn"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CmTrans" Storyboard.TargetProperty="Y" To="6" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 引擎下拉選單項目樣式：圓角、高亮、字型 -->
    <Style x:Key="EngineMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
            <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" ContentSource="Icon" Margin="0,0,8,0"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter TargetName="ItemBorder" Property="Background" Value="#333333"/>
                <Setter Property="Foreground" Value="#93C5FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 引擎選擇下拉選單（使用上面樣式，項目動態填充） -->
        <ContextMenu x:Key="EngineContextMenu" Placement="Bottom" Style="{StaticResource EngineContextMenuStyle}">
            <!-- 項目由後置碼動態填充 -->
        </ContextMenu>

        <!-- 通用圖示按鈕樣式 -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                Padding="{TemplateBinding Padding}"
                                x:Name="ButtonBorder">
                                                        <Path Data="{TemplateBinding Tag}" 
                                                                    Fill="{TemplateBinding Foreground}"
                                                                    Stroke="{TemplateBinding Foreground}"
                                                                    StrokeThickness="1.6"
                                                                    StrokeStartLineCap="Round"
                                                                    StrokeEndLineCap="Round"
                                                                    StrokeLineJoin="Round"
                                                                    SnapsToDevicePixels="True"
                                                                    Stretch="Uniform"
                                                                    x:Name="ButtonIcon"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#55FFFFFF"/>
                                                                <Setter TargetName="ButtonIcon" Property="Fill" Value="#FFD700"/>
                                                                <Setter TargetName="ButtonIcon" Property="Stroke" Value="#FFD700"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                           Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                           To="1.1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                           Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                           To="1.1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                           Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                           To="1.0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                           Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                           To="1.0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#77FFFFFF"/>
                                <Setter TargetName="ButtonIcon" Property="Fill" Value="#FFA500"/>
                                <Setter TargetName="ButtonIcon" Property="Stroke" Value="#FFA500"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                           Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                           To="0.95" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                           Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                           To="0.95" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Switch 樣式 -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Width="28" Height="16" CornerRadius="8" Background="#6B7280" x:Name="SwitchTrack">
                            <Ellipse Width="10" Height="10" Fill="White" HorizontalAlignment="Left" x:Name="SwitchDot">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="3" x:Name="DotTransform"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="DotTransform" Storyboard.TargetProperty="X" To="15" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="DotTransform" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 1號按鈕旋轉一次的動畫 -->
        <Storyboard x:Key="StartButtonSpinOnce">
            <DoubleAnimation Storyboard.TargetName="StartTranslateButton"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             By="360" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

    </Window.Resources>

    <!-- 主容器，使用 Border 實現圓角、邊框和背景 - 支持拖拽 -->
    <Border x:Name="MainBorder" 
            CornerRadius="22" BorderThickness="1" BorderBrush="#44888888" Padding="10,6">
        <Border.Background>
            <SolidColorBrush Color="Black" Opacity="0.9"/>
        </Border.Background>
        <Border.Effect>
            <BlurEffect Radius="1"/>
        </Border.Effect>

        <Grid>
            <!-- 拖拽區域 - 覆蓋整個窗口但不包括按鈕 -->
            <Border x:Name="DragArea" 
                    Background="Transparent"
                    MouseLeftButtonDown="Window_MouseLeftButtonDown"/>

            <!-- 右側觸發區域 (拖拽調整大小) - 擴大觸發範圍 -->
            <Border x:Name="RightTriggerArea" 
                    Width="25" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Stretch" 
                    Background="Transparent"
                    MouseEnter="RightTriggerArea_MouseEnter"
                    MouseLeave="RightTriggerArea_MouseLeave"
                    MouseLeftButtonDown="RightTriggerArea_MouseLeftButtonDown"
                    MouseMove="RightTriggerArea_MouseMove"
                    MouseLeftButtonUp="RightTriggerArea_MouseLeftButtonUp"
                    Cursor="SizeWE"/>

            <!-- 主內容區域 -->
            <StackPanel x:Name="MainStackPanel" 
                        Orientation="Horizontal" 
                        VerticalAlignment="Center">

                <!-- 1. 開始翻譯按鈕 -->
                <Button x:Name="StartTranslateButton" 
                        Style="{StaticResource IconButton}" 
                        Tag="{StaticResource IconPlay}" 
                        Command="{Binding StartTranslationCommand}">
                    <Button.RenderTransform>
                        <RotateTransform CenterX="12" CenterY="12"/>
                    </Button.RenderTransform>
                </Button>

                <!-- 可收縮的內容區域 -->
                <StackPanel x:Name="CollapsibleContent" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center">

                    <!-- 2. 會員狀態 -->
                    <Button Padding="6,3" Margin="6,0,0,0" Cursor="Hand" BorderThickness="0"
                            Command="{Binding UpgradeToProCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="999" Padding="{TemplateBinding Padding}" x:Name="ProBorder">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FBBF24" Offset="0.0" />
                                            <GradientStop Color="#F59E0B" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ProBorder"
                                                                   Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                                   To="1.05" Duration="0:0:0.15">
                                                        <DoubleAnimation.EasingFunction>
                                                            <BackEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="ProBorder"
                                                                   Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                                   To="1.05" Duration="0:0:0.15">
                                                        <DoubleAnimation.EasingFunction>
                                                            <BackEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ProBorder"
                                                                   Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                                   To="1.0" Duration="0:0:0.15"/>
                                                    <DoubleAnimation Storyboard.TargetName="ProBorder"
                                                                   Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                                   To="1.0" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.RenderTransformOrigin>
                            <Point X="0.5" Y="0.5"/>
                        </Button.RenderTransformOrigin>
                        <Button.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Button.RenderTransform>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconCrown}" Fill="Black" Width="10" Height="10" VerticalAlignment="Center"/>
                            <TextBlock Text="PRO" Foreground="Black" FontWeight="Bold" VerticalAlignment="Center" Margin="3,0,0,0" FontSize="9"/>
                        </StackPanel>
                    </Button>

                    <!-- 3. 今日剩餘翻譯點數 -->
                    <Button Background="Transparent" BorderThickness="0" Padding="3,2" Cursor="Hand"
                            Command="{Binding DailyCheckInCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        CornerRadius="4"
                                        Padding="{TemplateBinding Padding}"
                                        x:Name="CountBorder">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CountBorder" Property="Background" Value="#33FFFFFF"/>
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="CountBorder"
                                                                   Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                                   To="1.05" Duration="0:0:0.15"/>
                                                    <DoubleAnimation Storyboard.TargetName="CountBorder"
                                                                   Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                                   To="1.05" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="CountBorder"
                                                                   Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                                   To="1.0" Duration="0:0:0.15"/>
                                                    <DoubleAnimation Storyboard.TargetName="CountBorder"
                                                                   Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                                   To="1.0" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.RenderTransformOrigin>
                            <Point X="0.5" Y="0.5"/>
                        </Button.RenderTransformOrigin>
                        <Button.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Button.RenderTransform>
                        <TextBlock Text="{Binding RemainingTranslations}" 
                                   Foreground="#93C5FD" 
                                   FontSize="14" 
                                   FontWeight="Medium" 
                                   VerticalAlignment="Center"/>
                    </Button>

            <!-- 4. 硬幣餘額 -->
            <Button Background="Transparent" BorderThickness="0" Padding="4,2" Margin="8,0,0,0" Cursor="Hand"
                    Command="{Binding PurchaseCoinsCommand}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#33FFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconCoins}" Fill="#FBBF24" Width="12" Height="12" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CoinBalance}" 
                               Foreground="White" 
                               FontSize="11" 
                               VerticalAlignment="Center" 
                               Margin="4,0,0,0"/>
                </StackPanel>
            </Button>

            <!-- 分隔線 -->
            <Rectangle Fill="#44888888" Width="1" Height="16" Margin="12,0"/>

            <!-- 5. 翻譯引擎選擇 -->
        <Border x:Name="EngineSelectorBorder" Background="#80000000" CornerRadius="4" Padding="10,6,12,6" Cursor="Hand"
                    MouseLeftButtonUp="EngineSelectorBorder_MouseLeftButtonUp" MinWidth="100">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Fill="#4ADE80" Width="8" Height="8" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedEngine}" 
                               Foreground="White" 
                               FontSize="11" 
                               VerticalAlignment="Center"
                               Margin="8,0,8,0"/>
              <Path x:Name="EngineChevronPath"
                  Data="{StaticResource IconChevronDown}"
                  Stroke="#E6FFFFFF"
                  StrokeThickness="2.2"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  Width="12"
                  Height="12"
                  Stretch="Uniform"
                  SnapsToDevicePixels="True"
                  VerticalAlignment="Center"
                  Margin="0,-2,2,0"/>
                </StackPanel>
            </Border>

            <!-- 引擎選擇下拉選單（在窗口資源中定義） -->

            <!-- 6. 翻譯引擎對比 -->
            <Button Style="{StaticResource IconButton}" 
                    Tag="{StaticResource IconGitCompare}" 
                    Margin="4,0,0,0"
                    Command="{Binding CompareEnginesCommand}"/>

            <!-- 7. 翻譯語言設置 - 可點選的大方框設計 -->
            <Button Background="#80000000" 
                    BorderBrush="White" 
                    BorderThickness="1"
                    Padding="8,4" 
                    Margin="4,0,0,0" 
                    MinWidth="80" 
                    MaxWidth="120"
                    Cursor="Hand"
                    Command="{Binding LanguageSettingsCommand}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#A0000000"/>
                                            <Setter Property="BorderBrush" Value="#FFE0E0E0"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- 源語言 -->
                    <TextBlock Text="{Binding SourceLanguage}" 
                               Foreground="White" 
                               FontSize="10"
                               FontWeight="Medium"
                               TextAlignment="Center"
                               MinWidth="20"
                               Margin="0,0,2,0"/>
                    
                    <!-- 箭頭符號 -->
                    <TextBlock Text="→" 
                               Foreground="White" 
                               FontSize="12"
                               FontWeight="Bold"
                               Margin="2,0"
                               VerticalAlignment="Center"/>
                    
                    <!-- 目標語言 -->
                    <TextBlock Text="{Binding TargetLanguage}" 
                               Foreground="White" 
                               FontSize="10"
                               FontWeight="Medium"
                               TextAlignment="Center"
                               MinWidth="20"
                               Margin="2,0,0,0"/>
                </StackPanel>
            </Button>

            <!-- 8. 自定義詞典 -->
            <Button Style="{StaticResource IconButton}" 
                    Tag="{StaticResource IconBookOpen}" 
                    Margin="4,0,0,0"
                    Command="{Binding OpenDictionaryCommand}"/>

            <!-- 9. 快速截圖翻譯 -->
            <Button Style="{StaticResource IconButton}" 
                    Tag="{StaticResource IconCamera}" 
                    Margin="4,0,0,0"
                    Command="{Binding QuickScreenshotCommand}"/>

            <!-- 分隔線 -->
            <Rectangle Fill="#44888888" Width="1" Height="16" Margin="12,0"/>

            <!-- 10. 翻譯區域選擇 -->
            <Button Style="{StaticResource IconButton}" 
                    Tag="{StaticResource IconSquare}"
                    Command="{Binding SelectRegionCommand}"/>
            <!-- 11. 翻譯區域2選擇 -->
            <Button Style="{StaticResource IconButton}" 
                    Tag="{StaticResource IconSquareDot}"
                    Command="{Binding SelectRegion2Command}"/>
            <!-- 12. 漫畫翻譯優化 -->
            <Button Style="{StaticResource IconButton}" 
                    Tag="{StaticResource IconPalette}"
                    Command="{Binding ComicModeCommand}"/>

            <!-- 分隔線 -->
            <Rectangle Fill="#44888888" Width="1" Height="16" Margin="12,0"/>

            <!-- 13. 覆蓋模式切換 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Style="{StaticResource ToggleSwitchStyle}" 
                          IsChecked="{Binding IsCoverModeEnabled}" 
                          Tag="#3B82F6"/>
                <TextBlock Text="COVER" Foreground="White" FontSize="10" Margin="4,0,0,0"/>
            </StackPanel>

            <!-- 14. 自動翻譯開關 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <CheckBox Style="{StaticResource ToggleSwitchStyle}" 
                          IsChecked="{Binding IsAutoTranslateEnabled}" 
                          Tag="#22C55E"/>
                <TextBlock Text="AUTO" Foreground="White" FontSize="10" Margin="4,0,0,0"/>
            </StackPanel>

            <!-- 分隔線 -->
            <Rectangle Fill="#44888888" Width="1" Height="16" Margin="12,0"/>

            <!-- 15. 編輯窗口 -->
            <Button Style="{StaticResource IconButton}" 
                    Tag="{StaticResource IconEdit3}"
                    Command="{Binding OpenEditorCommand}"/>
            <!-- 16. 更多工具 -->
            <Button Style="{StaticResource IconButton}" 
                    Tag="{StaticResource IconMoreHorizontal}"
                    Command="{Binding ShowMoreToolsCommand}"/>
            <!-- 17. 設置 -->
            <Button Style="{StaticResource IconButton}" 
                    Tag="{StaticResource IconSettings}"
                    Command="{Binding OpenSettingsCommand}"/>

            <!-- 分隔線 -->
            <Rectangle Fill="#44888888" Width="1" Height="16" Margin="12,0"/>

            <!-- 18. 最小化 -->
            <Button x:Name="MinimizeButton" 
                    Style="{StaticResource IconButton}" 
                    Tag="{StaticResource IconMinus}" 
                    Command="{Binding MinimizeCommand}"/>
            <!-- 19. 關閉 -->
            <Button x:Name="CloseButton" 
                    Style="{StaticResource IconButton}" 
                    Tag="{StaticResource IconX}" 
                    Command="{Binding ExitCommand}"/>
            
                </StackPanel> <!-- 結束 CollapsibleContent -->

            <!-- 20. 收縮工具條 -->
            <Button x:Name="CollapseToggleButton"
                    Style="{StaticResource IconButton}" 
                    Tag="{Binding CollapseButtonIcon, RelativeSource={RelativeSource AncestorType=Window}}"
                    Command="{Binding CollapseCommand}"/>

            <!-- 21. 移動工具條 - 虛有其表的擺設，實際是普通拖拽區域 -->
            <Border x:Name="MoveArea"
                    Width="24"
                    Height="24"
                    Background="Transparent"
                    ToolTip="拖拽移動工具條"
                    MouseLeftButtonDown="Window_MouseLeftButtonDown"
                    Cursor="Arrow">
                <Path Data="{StaticResource IconGripVertical}" 
                      Fill="White" 
                      Stroke="White"
                      StrokeThickness="1.5"
                      Width="12" 
                      Height="12" 
                      Stretch="Uniform"
                      IsHitTestVisible="False"/>
            </Border>

            </StackPanel> <!-- 結束 MainStackPanel -->
        </Grid>
    </Border>
</Window>
