<Window x:Class="MonLingo.View.Windows.MainBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MonLingo 主工具列" 
        Width="400" Height="60"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- 按鈕樣式定義 -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF404040"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF1E1E1E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主容器樣式 -->
        <Style x:Key="MainContainerStyle" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF1E1E1E" Offset="0"/>
                        <GradientStop Color="#FF2D2D30" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#FF404040"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Direction="270" 
                                    ShadowDepth="4" Opacity="0.5" BlurRadius="8"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 主容器 -->
    <Border Style="{StaticResource MainContainerStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 應用程式圖示和標題 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" 
                       VerticalAlignment="Center" Margin="12,0,0,0">
                <Image Source="/MonLingo.Core;component/Resources/Icons/app-icon.png" 
                       Width="24" Height="24" 
                       VerticalAlignment="Center"/>
                <TextBlock Text="MonLingo" 
                          Foreground="White" 
                          FontSize="14" 
                          FontWeight="Bold"
                          VerticalAlignment="Center" 
                          Margin="8,0,0,0"/>
            </StackPanel>

            <!-- 中央工具按鈕區域 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center">
                
                <!-- 螢幕翻譯按鈕 -->
                <Button Style="{StaticResource ModernButtonStyle}"
                        Command="{Binding CaptureCommand}"
                        ToolTip="螢幕翻譯 (Ctrl+Q)">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M7,13H17V11H7" 
                              Fill="White" Width="16" Height="16" 
                              Stretch="Fill" VerticalAlignment="Center"/>
                        <TextBlock Text="翻譯" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 音訊轉錄按鈕 -->
                <Button Style="{StaticResource ModernButtonStyle}"
                        Command="{Binding AudioCaptureCommand}"
                        ToolTip="音訊轉錄">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M12,2A3,3 0 0,1 15,5V11A3,3 0 0,1 12,14A3,3 0 0,1 9,11V5A3,3 0 0,1 12,2M19,11C19,14.53 16.39,17.44 13,17.93V21H11V17.93C7.61,17.44 5,14.53 5,11H7A5,5 0 0,0 12,16A5,5 0 0,0 17,11H19Z" 
                              Fill="White" Width="16" Height="16" 
                              Stretch="Fill" VerticalAlignment="Center"/>
                        <TextBlock Text="語音" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 歷史記錄按鈕 -->
                <Button Style="{StaticResource ModernButtonStyle}"
                        Command="{Binding HistoryCommand}"
                        ToolTip="翻譯歷史">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M13.5,8H12V13L16.28,15.54L17,14.33L13.5,12.25V8M13,3A9,9 0 0,0 4,12H1L4.96,16.03L9,12H6A7,7 0 0,1 13,5A7,7 0 0,1 20,12A7,7 0 0,1 13,19C11.07,19 9.32,18.21 8.06,16.94L6.64,18.36C8.27,20 10.5,21 13,21A9,9 0 0,0 22,12A9,9 0 0,0 13,3" 
                              Fill="White" Width="16" Height="16" 
                              Stretch="Fill" VerticalAlignment="Center"/>
                        <TextBlock Text="歷史" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 右側控制按鈕 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" 
                       VerticalAlignment="Center" Margin="0,0,12,0">
                
                <!-- 設定按鈕 -->
                <Button Style="{StaticResource ModernButtonStyle}"
                        Command="{Binding SettingsCommand}"
                        ToolTip="設定"
                        Width="32" Height="32"
                        Padding="0">
                    <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.22,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.22,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.68 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" 
                          Fill="White" Width="16" Height="16" 
                          Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

                <!-- 最小化按鈕 -->
                <Button Style="{StaticResource ModernButtonStyle}"
                        Command="{Binding MinimizeCommand}"
                        ToolTip="最小化到系統托盤"
                        Width="32" Height="32"
                        Padding="0">
                    <Path Data="M20,14H4V10H20" 
                          Fill="White" Width="16" Height="16" 
                          Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

                <!-- 關閉按鈕 -->
                <Button Style="{StaticResource ModernButtonStyle}"
                        Command="{Binding ExitCommand}"
                        ToolTip="退出程式"
                        Width="32" Height="32"
                        Padding="0">
                    <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" 
                          Fill="White" Width="16" Height="16" 
                          Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
