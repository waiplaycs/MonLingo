<Window x:Class="MonLingo.Core.View.Windows.TranslationOverlayHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Translation Overlay Frame"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    
    <!-- 翻譯框主體 - 半透明背景框 -->
    <Border Name="MainFrameBorder"
            Background="#40000000"
            BorderBrush="#80FFFFFF"
            BorderThickness="2"
            CornerRadius="8"
            Opacity="0.8">
        
        <!-- 主網格容器 -->
        <Grid>
            <!-- 內容區域 - 用於容納子翻譯視窗 -->
            <Canvas Name="TranslationCanvas" 
                    Background="Transparent"
                    ClipToBounds="True">
                <!-- 子翻譯視窗將相對於此Canvas定位 -->
            </Canvas>
            
            <!-- 提示文字 -->
            <TextBlock Text="點擊關閉翻譯"
                       Foreground="White"
                       FontSize="12"
                       Opacity="0.6"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Margin="0,5,10,0"/>
        </Grid>
    </Border>

    <!-- 淡入動畫 -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0.0" To="1.0"
                                     Duration="0:0:0.3"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
