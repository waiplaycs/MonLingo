<!-- ============================================================ -->
<!-- MonLingo 字幕視窗 0824 優化設計 -->
<!-- 日期: 2025年8月24日 -->
<!-- 與 MainBarWindow 工具條完美匹配的現代化字幕視窗 -->
<!-- ============================================================ -->

<Window x:Class="MonLingo.Core.View.Windows.SubtitleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:MonLingo.Core.Converters"
        mc:Ignorable="d"
        Title="MonLingo 字幕視窗"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="{Binding IsDetached}"
        ResizeMode="CanResize"
        MinWidth="350"
        MinHeight="150"
        Width="{Binding WindowWidth, Mode=TwoWay}"
        Height="{Binding WindowHeight, Mode=TwoWay}"
        Top="{Binding WindowTop, Mode=TwoWay}"
        Left="{Binding WindowLeft, Mode=TwoWay}"
        MouseDown="Window_MouseDown"
        MouseDoubleClick="Window_MouseDoubleClick"
        Opacity="0.95">

    <!-- 視窗資源 - 0824 設計優化 -->
    <Window.Resources>
        <!-- 轉換器 -->
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        
        <!-- 現代化淡入動畫 - 匹配工具條動畫風格 -->
        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- 滑入動畫 -->
        <Storyboard x:Key="SlideInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="20" To="0"
                             Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- 0824 字幕行樣式 - 匹配工具條的現代化設計 -->
        <Style x:Key="SubtitleLineStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#DD000000" Offset="0"/>
                        <GradientStop Color="#BB000000" Offset="0.5"/>
                        <GradientStop Color="#DD000000" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#66FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" 
                                      Direction="270" 
                                      ShadowDepth="2" 
                                      BlurRadius="8" 
                                      Opacity="0.6"/>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- 載入時觸發現代化動畫 -->
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0" To="1"
                                             Duration="0:0:0.5"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             From="15" To="0"
                                             Duration="0:0:0.6">
                                <DoubleAnimation.EasingFunction>
                                    <BackEase EasingMode="EaseOut" Amplitude="0.2"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <!-- Hover 效果 -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#88FFFFFF"/>
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#EE000000" Offset="0"/>
                                <GradientStop Color="#CC000000" Offset="0.5"/>
                                <GradientStop Color="#EE000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 0824 字幕文字樣式 - 現代化設計 -->
        <Style x:Key="SubtitleTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, 微軟雅黑, SimSun"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="LineHeight" Value="26"/>
            <Setter Property="TextTrimming" Value="None"/>
            <Setter Property="Margin" Value="15,10,15,5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <!-- 優化的文字陰影效果，提高可讀性 -->
                    <DropShadowEffect Color="Black" 
                                      Direction="270" 
                                      ShadowDepth="1" 
                                      BlurRadius="3" 
                                      Opacity="0.9"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 原文文字樣式 -->
        <Style x:Key="OriginalTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, 微軟雅黑, SimSun"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="Margin" Value="15,0,15,10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" 
                                      Direction="270" 
                                      ShadowDepth="1" 
                                      BlurRadius="2" 
                                      Opacity="0.7"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 標題列按鈕樣式 - 匹配工具條按鈕設計 -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#44FFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 主要內容區域 - 0824 現代化設計 -->
    <Grid x:Name="RootContainer">
        <!-- 主邊框 - 依附模式和分離模式不同樣式，匹配工具條設計風格 -->
        <Border x:Name="MainBorder"
                BorderBrush="Transparent"
                BorderThickness="0">
            
            <!-- 邊框樣式根據是否分離來決定，採用工具條相同的圓角設計 -->
            <Border.Style>
                <Style TargetType="Border">
                    <!-- 預設：依附模式 - 與工具條連接的無縫設計 -->
                    <Setter Property="CornerRadius" Value="0,0,22,22"/>
                    <Setter Property="Margin" Value="0,0,0,0"/>
                    <Style.Triggers>
                        <!-- 分離模式 - 全圓角，與工具條保持一致 -->
                        <DataTrigger Binding="{Binding IsDetached}" Value="True">
                            <Setter Property="CornerRadius" Value="22"/>
                            <Setter Property="Margin" Value="8"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            
            <!-- 現代化漸變背景效果 - 匹配工具條的背景風格 -->
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#E6000000" Offset="0"/>
                    <GradientStop Color="#CC000000" Offset="0.3"/>
                    <GradientStop Color="#B3000000" Offset="0.7"/>
                    <GradientStop Color="#E6000000" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <!-- 添加陰影效果，但依附模式時減少陰影以增強連接感 -->
            <Border.Effect>
                <DropShadowEffect Color="Black" 
                                  Direction="270" 
                                  ShadowDepth="2" 
                                  BlurRadius="8" 
                                  Opacity="0.5"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- 標題列（僅在分離模式顯示） -->
                    <RowDefinition Height="Auto"/>
                    <!-- 字幕內容區 -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 標題列 - 0824 現代化設計，僅在分離模式顯示 -->
                <Border Grid.Row="0" 
                        CornerRadius="22,22,0,0"
                        Padding="20,12"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <!-- 黑色標題欄背景，與工具條風格保持一致 -->
                    <Border.Background>
                        <SolidColorBrush Color="Black" Opacity="0.9"/>
                    </Border.Background>
                    <Border.Visibility>
                        <Binding Path="IsDetached">
                            <Binding.Converter>
                                <converters:BooleanToVisibilityConverter/>
                            </Binding.Converter>
                        </Binding>
                    </Border.Visibility>
                    
                    <!-- 標題列內容 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 標題文字 - 採用工具條相同的現代化字體 -->
                        <TextBlock Grid.Column="0" 
                                   Text="MonLingo 字幕視窗" 
                                   Foreground="White" 
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   FontFamily="Segoe UI, Microsoft YaHei UI, 微軟雅黑"
                                   VerticalAlignment="Center"/>

                        <!-- 依附按鈕 - 採用現代化圖標設計 -->
                        <Button Grid.Column="1" 
                                Content="📌" 
                                ToolTip="重新依附到工具條"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Margin="8,0"
                                FontSize="16"
                                Command="{Binding ReattachCommand}"/>

                        <!-- 關閉按鈕 - 採用現代化設計 -->
                        <Button Grid.Column="2" 
                                Content="✕" 
                                ToolTip="關閉字幕視窗"
                                Style="{StaticResource TitleBarButtonStyle}"
                                FontSize="14"
                                Command="{Binding CloseCommand}"/>
                    </Grid>
                </Border>

                <!-- 0824 現代化滾動檢視器 -->
                <ScrollViewer Grid.Row="1"
                              x:Name="SubtitleScrollViewer"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Hidden"
                              CanContentScroll="True"
                              Padding="0,16,8,16">
                    
                    <!-- 滾動條樣式 -->
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Width" Value="8"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Border Background="{TemplateBinding Background}">
                                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                <Track.Thumb>
                                                    <Thumb>
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Border Background="#66FFFFFF" CornerRadius="4"/>
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                            </Track>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ScrollViewer.Resources>
                    
                    <!-- 0824 字幕行列表 - 現代化設計 -->
                    <ItemsControl x:Name="SubtitleItemsControl"
                                  ItemsSource="{Binding SubtitleLines}">
                        <!-- 項目容器樣式 -->
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                <Setter Property="Margin" Value="0,0"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>

                        <!-- 項目面板：垂直堆疊 -->
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" Margin="0"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <!-- 0824 現代化項目範本 -->
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 移除 Border 和分隔效果，讓字幕看起來是一個整體 -->
                                <Grid Margin="0,4">
                                    <Grid.RowDefinitions>
                                        <!-- 主要譯文行 -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- 原文行（可選） -->
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                        <!-- 主要譯文 - 0824 現代化樣式 -->
                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding TranslatedText}"
                                                   Style="{StaticResource SubtitleTextStyle}"/>

                                    <!-- 原文 - 0824 優化樣式 -->
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding OriginalText}"
                                               Style="{StaticResource OriginalTextStyle}"
                                               Margin="15,0,15,5">
                                        <TextBlock.Visibility>
                                            <Binding Path="OriginalText" 
                                                     Converter="{StaticResource StringToVisibilityConverter}"/>
                                        </TextBlock.Visibility>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 拖拽縮放控制項 - 右下角可見按鈕 -->
        <Grid HorizontalAlignment="Right" 
              VerticalAlignment="Bottom" 
              Width="20" Height="20" 
              Margin="0,0,8,8"
              Background="Transparent"
              Cursor="SizeNWSE"
              MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown">
            
            <!-- 拖拽縮放圖示 -->
            <Grid>
                <!-- 背景圓角 -->
                <Border Background="#4D000000" 
                        CornerRadius="4"
                        Opacity="0.9">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" 
                                          BlurRadius="4" 
                                          Opacity="0.4" 
                                          ShadowDepth="2"/>
                    </Border.Effect>
                </Border>
                
                <!-- 拖拽線條圖示 - 使用固定白色 -->
                <Canvas>
                    <!-- 右下角拖拽線條 -->
                    <Line X1="6" Y1="16" X2="16" Y2="6" 
                          Stroke="White" 
                          StrokeThickness="2" 
                          Opacity="0.9"/>
                    <Line X1="10" Y1="16" X2="16" Y2="10" 
                          Stroke="White" 
                          StrokeThickness="2" 
                          Opacity="0.9"/>
                    <Line X1="14" Y1="16" X2="16" Y2="14" 
                          Stroke="White" 
                          StrokeThickness="2" 
                          Opacity="0.9"/>
                </Canvas>
            </Grid>
            
            <!-- 懸浮效果 -->
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="1"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.15" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.15" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.0" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.0" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </Style.Triggers>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                    <Setter Property="Opacity" Value="0.7"/>
                </Style>
            </Grid.Style>
        </Grid>

    </Grid>
</Window>
