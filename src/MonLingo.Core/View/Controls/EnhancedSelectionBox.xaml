<UserControl x:Class="MonLingo.Core.View.Controls.EnhancedSelectionBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="Transparent"
             IsHitTestVisible="True">
    
              <Grid Background="Transparent"
                                   IsHitTestVisible="True">
                            <!-- 主框架 - bb.png 風格：細藍色虛線 -->
                            <Rectangle x:Name="MainBorder" Stroke="#6B8AF6" StrokeThickness="1" 
                                                                Fill="Transparent"
                                                                StrokeDashArray="3,3"
                                                                IsHitTestVisible="False"/>
        
        <!-- 內容層 -->
         <Grid Margin="1" Background="Transparent" 
                IsHitTestVisible="True">
                         <!-- 頂部中央拖拽手柄 - 面積更小且貼合框線 -->
                         <Border x:Name="DragHandle"
                                Background="#E0E0E0"
                                BorderBrush="#BDBDBD" BorderThickness="1"
                                CornerRadius="5"
                                Height="10" Width="24"
                                VerticalAlignment="Top" HorizontalAlignment="Center"
                                Margin="0,-6,0,0" Cursor="SizeAll" Panel.ZIndex="1001"/>

           <!-- 左上角編號標籤 -->
           <Border x:Name="NumberBadge"
                     Background="#D1207AE7" CornerRadius="8"
                     Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="3,3,0,0" Panel.ZIndex="1002">
              <TextBlock x:Name="NumberLabel" Text="0" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
           </Border>
                      
           <!-- 右上角設置區域（固定大 hit-test 區域，避免滑鼠移動時脫離） -->
           <Border x:Name="SettingsArea" Width="80" Height="22"
                  Background="#01000000"
                  VerticalAlignment="Top" HorizontalAlignment="Right"
                  Margin="0,3,3,0" Panel.ZIndex="1002">
              <Grid>
                  <!-- 默認 3 點按鈕 -->
                  <Button x:Name="SettingsButton"
                         Content="⋯" Width="22" Height="22"
                         Background="#4A4A4A" Foreground="White"
                         BorderBrush="#4A4A4A" BorderThickness="0"
                         FontSize="12" Cursor="Hand"
                         HorizontalAlignment="Right"/>
                  <!-- 懸浮顯示的 Hide/Close，與 3 點在同一區域重疊 -->
                  <StackPanel x:Name="ActionButtons" Orientation="Horizontal"
                            Visibility="Collapsed" HorizontalAlignment="Right">
                     <Button x:Name="HideButton" Content="👁" Width="22" Height="22"
                            Background="#F5F5F5" Foreground="#333"
                            BorderBrush="#BDBDBD" BorderThickness="1"
                            FontSize="12" Cursor="Hand" Margin="0,0,2,0"
                            ToolTip="隱藏框"/>
                     <Button x:Name="CloseButton" Content="✕" Width="22" Height="22"
                            Background="#FDECEA" Foreground="#C62828"
                            BorderBrush="#FFCDD2" BorderThickness="1"
                            FontSize="12" Cursor="Hand"
                            ToolTip="關閉框"/>
                  </StackPanel>
              </Grid>
           </Border>
        </Grid>
        
       <!-- 8個調整控制點（灰色小圓點，更貼近 bb.png 風格） -->
        
        <!-- 四個角落控制點 -->
       <Ellipse x:Name="TopLeftResize" Fill="#F2F2F2" Stroke="#B0B0B0" Width="8" Height="8" 
                 VerticalAlignment="Top" HorizontalAlignment="Left" 
                 Margin="-4,-4,0,0" Cursor="SizeNWSE" Panel.ZIndex="1000"
                 IsHitTestVisible="True"/>
                 
       <Ellipse x:Name="TopRightResize" Fill="#F2F2F2" Stroke="#B0B0B0" Width="8" Height="8" 
                 VerticalAlignment="Top" HorizontalAlignment="Right" 
                 Margin="0,-4,-4,0" Cursor="SizeNESW" Panel.ZIndex="1000"
                 IsHitTestVisible="True"/>
                 
       <Ellipse x:Name="BottomLeftResize" Fill="#F2F2F2" Stroke="#B0B0B0" Width="8" Height="8" 
                 VerticalAlignment="Bottom" HorizontalAlignment="Left" 
                 Margin="-4,0,0,-4" Cursor="SizeNESW" Panel.ZIndex="1000"
                 IsHitTestVisible="True"/>
                 
       <Ellipse x:Name="BottomRightResize" Fill="#F2F2F2" Stroke="#B0B0B0" Width="8" Height="8" 
                 VerticalAlignment="Bottom" HorizontalAlignment="Right" 
                 Margin="0,0,-4,-4" Cursor="SizeNWSE" Panel.ZIndex="1000"
                 IsHitTestVisible="True"/>
        
       <!-- 四邊中點控制點已移除（僅保留四角） -->
    </Grid>
</UserControl>
