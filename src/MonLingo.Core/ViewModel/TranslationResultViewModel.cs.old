using System;
using System.Collections.ObjectModel;
using System.ComponentModel;
using System.Threading.Tasks;
using System.Windows.Input;

namespace MonLingo.Core.ViewModel
{
    // 消息類型枚舉
    public enum MessageType
    {
        Info,
        Success,
        Warning,
        Error
    }

    /// <summary>
    /// 簡化版翻譯結果ViewModel - 用於Phase6測試
    /// </summary>
    public class TranslationResultViewModel : INotifyPropertyChanged, IDisposable
    {
        public event PropertyChangedEventHandler PropertyChanged;
        
        // 事件
        public event EventHandler CloseRequested;
        public event EventHandler TranslationCompleted;

        // 基本屬性
        private string _originalText = "";
        private string _translatedText = "";
        private bool _isLoading = false;
        private string _sourceLang = "auto";
        private string _targetLang = "zh-TW";
        private System.Windows.Rect _sourceRegion;

        public string OriginalText
        {
            get => _originalText;
            set
            {
                _originalText = value;
                OnPropertyChanged(nameof(OriginalText));
            }
        }

        public string TranslatedText
        {
            get => _translatedText;
            set
            {
                _translatedText = value;
                OnPropertyChanged(nameof(TranslatedText));
            }
        }

        public bool IsLoading
        {
            get => _isLoading;
            set
            {
                _isLoading = value;
                OnPropertyChanged(nameof(IsLoading));
            }
        }

        public string SourceLang
        {
            get => _sourceLang;
            set
            {
                _sourceLang = value;
                OnPropertyChanged(nameof(SourceLang));
            }
        }

        public string TargetLang
        {
            get => _targetLang;
            set
            {
                _targetLang = value;
                OnPropertyChanged(nameof(TargetLang));
            }
        }

        // 翻譯歷史
        public ObservableCollection<TranslationHistory> History { get; set; } = new ObservableCollection<TranslationHistory>();

        // 命令
        public ICommand CopyOriginalCommand { get; private set; }
        public ICommand CopyTranslationCommand { get; private set; }
        public ICommand RetranslateCommand { get; private set; }
        public ICommand AddToFavoritesCommand { get; private set; }

        public TranslationResultViewModel()
        {
            InitializeCommands();
        }

        // 支援帶參數的構造函數
        public TranslationResultViewModel(System.Windows.Rect sourceRegion) : this()
        {
            _sourceRegion = sourceRegion;
        }

        private void InitializeCommands()
        {
            CopyOriginalCommand = new SimpleRelayCommand(() => CopyToClipboard(OriginalText));
            CopyTranslationCommand = new SimpleRelayCommand(() => CopyToClipboard(TranslatedText));
            RetranslateCommand = new SimpleRelayCommand(async () => await RetranslateAsync());
            AddToFavoritesCommand = new SimpleRelayCommand(() => AddToFavorites());
        }

        // 開始翻譯方法
        public async void StartTranslation()
        {
            IsLoading = true;
            try
            {
                // 模擬翻譯過程
                await Task.Delay(1500);
                
                // 設置示例翻譯結果
                OriginalText = "Sample text for translation";
                TranslatedText = "翻譯範例文字";
                
                // 觸發翻譯完成事件
                TranslationCompleted?.Invoke(this, EventArgs.Empty);
            }
            finally
            {
                IsLoading = false;
            }
        }

        // 顯示消息方法
        public void ShowMessage(string message, MessageType messageType)
        {
            // 簡化的消息顯示 - 可以擴展為實際的消息框或通知
            Console.WriteLine($"[{messageType}] {message}");
        }

        private void CopyToClipboard(string text)
        {
            try
            {
                System.Windows.Clipboard.SetText(text ?? "");
            }
            catch { }
        }

        private async Task RetranslateAsync()
        {
            IsLoading = true;
            try
            {
                // 模擬翻譯延遲
                await Task.Delay(1000);
                TranslatedText = $"重新翻譯: {OriginalText}";
            }
            finally
            {
                IsLoading = false;
            }
        }

        private void AddToFavorites()
        {
            // 簡化的收藏功能
            var history = new TranslationHistory
            {
                OriginalText = OriginalText,
                TranslatedText = TranslatedText,
                Timestamp = DateTime.Now
            };
            History.Add(history);
        }

        protected virtual void OnPropertyChanged(string propertyName)
        {
            PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(propertyName));
        }

        public void Dispose()
        {
            // 清理資源
            CloseRequested = null;
            TranslationCompleted = null;
        }
    }

    // 翻譯歷史項目
    public class TranslationHistory
    {
        public string OriginalText { get; set; }
        public string TranslatedText { get; set; }
        public DateTime Timestamp { get; set; }
    }

    // 簡化的RelayCommand實現
    public class SimpleRelayCommand : ICommand
    {
        private readonly Action _execute;
        private readonly Func<Task> _executeAsync;
        private readonly Func<bool> _canExecute;

        public event EventHandler CanExecuteChanged;

        public SimpleRelayCommand(Action execute, Func<bool> canExecute = null)
        {
            _execute = execute ?? throw new ArgumentNullException(nameof(execute));
            _canExecute = canExecute;
        }

        public SimpleRelayCommand(Func<Task> executeAsync, Func<bool> canExecute = null)
        {
            _executeAsync = executeAsync ?? throw new ArgumentNullException(nameof(executeAsync));
            _canExecute = canExecute;
        }

        public bool CanExecute(object parameter)
        {
            return _canExecute?.Invoke() ?? true;
        }

        public async void Execute(object parameter)
        {
            if (_executeAsync != null)
            {
                await _executeAsync();
            }
            else
            {
                _execute?.Invoke();
            }
        }

        public void RaiseCanExecuteChanged()
        {
            CanExecuteChanged?.Invoke(this, EventArgs.Empty);
        }
    }
}
