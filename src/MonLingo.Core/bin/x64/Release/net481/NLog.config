<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <!-- 目標定義 -->
  <targets>
    <!-- 文件日誌 -->
    <target xsi:type="File" 
            name="fileTarget"
            fileName="${specialfolder:folder=ApplicationData}/MonLingo/logs/MonLingo-${shortdate}.log"
            layout="${longdate} [${uppercase:${level}}] ${logger} - ${message} ${exception:format=tostring}"
            archiveFileName="${specialfolder:folder=ApplicationData}/MonLingo/logs/archive/MonLingo.{#}.log"
            archiveEvery="Day"
            archiveNumbering="Rolling"
            maxArchiveFiles="7"
            concurrentWrites="true"
            keepFileOpen="false" />

    <!-- 控制台日誌 (Visual Studio 輸出) -->
    <target xsi:type="Debugger" 
            name="debugTarget"
            layout="[${uppercase:${level}}] ${logger:shortName=true} - ${message}" />

    <!-- 錯誤日誌分離 -->
    <target xsi:type="File" 
            name="errorFileTarget"
            fileName="${specialfolder:folder=ApplicationData}/MonLingo/logs/MonLingo-Errors-${shortdate}.log"
            layout="${longdate} [${uppercase:${level}}] ${logger} - ${message} ${exception:format=tostring}"
            archiveFileName="${specialfolder:folder=ApplicationData}/MonLingo/logs/archive/MonLingo-Errors.{#}.log"
            archiveEvery="Day"
            archiveNumbering="Rolling"
            maxArchiveFiles="30"
            concurrentWrites="true"
            keepFileOpen="false" />

    <!-- 性能監控專用日誌 -->
    <target xsi:type="File" 
            name="performanceTarget"
            fileName="${specialfolder:folder=ApplicationData}/MonLingo/logs/MonLingo-Performance-${shortdate}.log"
            layout="${longdate} - ${message}"
            archiveFileName="${specialfolder:folder=ApplicationData}/MonLingo/logs/archive/MonLingo-Performance.{#}.log"
            archiveEvery="Day"
            archiveNumbering="Rolling"
            maxArchiveFiles="7"
            concurrentWrites="true"
            keepFileOpen="false" />
  </targets>

  <!-- 日誌規則 -->
  <rules>
    <!-- 所有日誌寫入主文件 -->
    <logger name="*" minlevel="Debug" writeTo="fileTarget" />
    
    <!-- Debug 模式下輸出到 Visual Studio -->
    <logger name="*" minlevel="Debug" writeTo="debugTarget" />
    
    <!-- 錯誤和警告寫入專用錯誤日誌 -->
    <logger name="*" minlevel="Warn" writeTo="errorFileTarget" />
    
    <!-- 性能監控日誌 -->
    <logger name="MonLingo.Core.Infrastructure.PerformanceMetrics" minlevel="Info" writeTo="performanceTarget" final="true" />
    
    <!-- 減少第三方套件的日誌噪音 -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.*" maxlevel="Info" final="true" />
  </rules>

</nlog>
