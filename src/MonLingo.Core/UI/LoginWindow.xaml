<Window x:Class="MonLingo.Core.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MonLingo 登入" 
        Height="600" 
        Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None">
    
    <Window.Resources>
        <!-- 按鈕樣式 -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#005a9e"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#004578"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 文本框樣式 -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 密碼框樣式 -->
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 連結樣式 -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#007ACC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#005a9e"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 主容器 -->
    <Border Background="White" 
            CornerRadius="12" 
            BorderBrush="#E0E0E0" 
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.1" ShadowDepth="5" BlurRadius="15"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 標題欄 -->
            <Grid Grid.Row="0" Background="#F8F9FA" Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 拖拽區域 -->
                <Rectangle Grid.Column="0" Fill="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>

                <!-- 關閉按鈕 -->
                <Button Grid.Column="1" 
                        Content="✕" 
                        Width="40" 
                        Height="40"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="16"
                        Foreground="#666"
                        Click="CloseButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FF5555"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- 主要內容 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="40,30,40,40">

                    <!-- Logo 和標題 -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,30">
                        <TextBlock Text="🌐" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="MonLingo" 
                                   FontSize="28" 
                                   FontWeight="Bold" 
                                   Foreground="#333"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="智能翻譯助手" 
                                   FontSize="14" 
                                   Foreground="#666"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- 登入/註冊選擇 -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="LoginTab" 
                                Grid.Column="0" 
                                Content="登入" 
                                Height="40"
                                Background="#007ACC"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Click="LoginTab_Click"/>

                        <Button x:Name="RegisterTab" 
                                Grid.Column="1" 
                                Content="註冊" 
                                Height="40"
                                Background="#F5F5F5"
                                Foreground="#666"
                                BorderThickness="0"
                                FontSize="14"
                                Click="RegisterTab_Click"/>
                    </Grid>

                    <!-- 登入表單 -->
                    <StackPanel x:Name="LoginForm" Visibility="Visible">
                        <!-- 電子郵件 -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="電子郵件" FontWeight="Medium" Margin="0,0,0,5" Foreground="#333"/>
                            <TextBox x:Name="EmailTextBox" 
                                     Style="{StaticResource ModernTextBox}"
                                     Height="40"/>
                        </StackPanel>

                        <!-- 密碼 -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="密碼" FontWeight="Medium" Margin="0,0,0,5" Foreground="#333"/>
                            <PasswordBox x:Name="PasswordBox" 
                                         Style="{StaticResource ModernPasswordBox}"
                                         Height="40"/>
                        </StackPanel>

                        <!-- 記住我和忘記密碼 -->
                        <Grid Margin="0,0,0,20">
                            <CheckBox x:Name="RememberMeCheckBox" 
                                      Content="記住我" 
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"/>
                            <Button Content="忘記密碼？" 
                                    Style="{StaticResource LinkButton}"
                                    HorizontalAlignment="Right"
                                    Click="ForgotPassword_Click"/>
                        </Grid>

                        <!-- 登入按鈕 -->
                        <Button x:Name="LoginButton" 
                                Content="登入" 
                                Style="{StaticResource ModernButton}"
                                Height="45"
                                Margin="0,0,0,20"
                                Click="LoginButton_Click"/>

                        <!-- 或者分隔線 -->
                        <Grid Margin="0,0,0,20">
                            <Separator Background="#E0E0E0"/>
                            <TextBlock Text="或者" 
                                       Background="White" 
                                       Padding="10,0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#666"/>
                        </Grid>

                        <!-- 其他登入方式 -->
                        <StackPanel>
                            <Button Content="📱 手機簡訊登入" 
                                    Height="40"
                                    Background="#28A745"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Margin="0,0,0,10"
                                    FontSize="14"
                                    Click="SmsLogin_Click"/>

                            <Button Content="🔗 Google 登入" 
                                    Height="40"
                                    Background="#DB4437"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Margin="0,0,0,10"
                                    FontSize="14"
                                    Click="GoogleLogin_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 註冊表單 -->
                    <StackPanel x:Name="RegisterForm" Visibility="Collapsed">
                        <!-- 使用者名稱 -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="使用者名稱" FontWeight="Medium" Margin="0,0,0,5" Foreground="#333"/>
                            <TextBox x:Name="UsernameTextBox" 
                                     Style="{StaticResource ModernTextBox}"
                                     Height="40"/>
                        </StackPanel>

                        <!-- 電子郵件 -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="電子郵件" FontWeight="Medium" Margin="0,0,0,5" Foreground="#333"/>
                            <TextBox x:Name="RegisterEmailTextBox" 
                                     Style="{StaticResource ModernTextBox}"
                                     Height="40"/>
                        </StackPanel>

                        <!-- 密碼 -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="密碼" FontWeight="Medium" Margin="0,0,0,5" Foreground="#333"/>
                            <PasswordBox x:Name="RegisterPasswordBox" 
                                         Style="{StaticResource ModernPasswordBox}"
                                         Height="40"/>
                        </StackPanel>

                        <!-- 確認密碼 -->
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="確認密碼" FontWeight="Medium" Margin="0,0,0,5" Foreground="#333"/>
                            <PasswordBox x:Name="ConfirmPasswordBox" 
                                         Style="{StaticResource ModernPasswordBox}"
                                         Height="40"/>
                        </StackPanel>

                        <!-- 服務條款 -->
                        <CheckBox x:Name="AgreeTermsCheckBox" 
                                  Margin="0,0,0,20">
                            <CheckBox.Content>
                                <TextBlock>
                                    <Run Text="我同意"/>
                                    <Hyperlink Foreground="#007ACC" Click="TermsOfService_Click">服務條款</Hyperlink>
                                    <Run Text="和"/>
                                    <Hyperlink Foreground="#007ACC" Click="PrivacyPolicy_Click">隱私政策</Hyperlink>
                                </TextBlock>
                            </CheckBox.Content>
                        </CheckBox>

                        <!-- 註冊按鈕 -->
                        <Button x:Name="RegisterButton" 
                                Content="註冊" 
                                Style="{StaticResource ModernButton}"
                                Height="45"
                                Click="RegisterButton_Click"/>
                    </StackPanel>

                    <!-- 載入指示器 -->
                    <Grid x:Name="LoadingPanel" Visibility="Collapsed" Margin="0,20,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Height="4" Width="200" Margin="0,0,0,10"/>
                            <TextBlock x:Name="LoadingText" 
                                       Text="正在處理..." 
                                       HorizontalAlignment="Center"
                                       Foreground="#666"/>
                        </StackPanel>
                    </Grid>

                    <!-- 錯誤訊息 -->
                    <Border x:Name="ErrorPanel" 
                            Background="#FFF5F5" 
                            BorderBrush="#FF6B6B" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="12"
                            Margin="0,15,0,0"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ErrorText" 
                                   Foreground="#D63384" 
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- 成功訊息 -->
                    <Border x:Name="SuccessPanel" 
                            Background="#F0F9F0" 
                            BorderBrush="#28A745" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="12"
                            Margin="0,15,0,0"
                            Visibility="Collapsed">
                        <TextBlock x:Name="SuccessText" 
                                   Foreground="#155724" 
                                   TextWrapping="Wrap"/>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
