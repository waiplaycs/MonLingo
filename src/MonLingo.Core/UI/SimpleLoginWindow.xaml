<Window x:Class="MonLingo.Core.UI.SimpleLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登入 - MonLingo" Height="300" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 標題 -->
        <TextBlock Grid.Row="0" Text="登入 MonLingo" 
                   FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,20,0,20"/>
        
        <!-- 登入表單 -->
        <StackPanel Grid.Row="1" Margin="50,0">
            <TextBlock Text="電子郵件:" Margin="0,0,0,5"/>
            <TextBox Name="EmailTextBox" Height="30" Margin="0,0,0,15"
                     Text="demo@example.com"/>
            
            <TextBlock Text="密碼:" Margin="0,0,0,5"/>
            <PasswordBox Name="PasswordTextBox" Height="30" Margin="0,0,0,20"
                         Password="demo123"/>
            
            <Button Name="LoginButton" Content="登入" Height="35" 
                    Background="#007ACC" Foreground="White"
                    Click="LoginButton_Click"/>
        </StackPanel>
        
        <!-- 按鈕區域 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="20">
            <Button Name="CancelButton" Content="取消" Width="80" Height="30"
                    Margin="0,0,10,0" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
