<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net481</TargetFramework>
    <Platform>x64</Platform>
    <UseWPF>true</UseWPF>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>MonLingo.Core</AssemblyName>
    <RootNamespace>MonLingo.Core</RootNamespace>
    <AssemblyTitle>MonLingo Core Application</AssemblyTitle>
    <AssemblyDescription>MonLingo WPF 核心應用程式 - 對應 Gaminik 架構</AssemblyDescription>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Copyright>Copyright © 2025</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <StartupObject>MonLingo.Core.Program</StartupObject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <DefineConstants>TRACE</DefineConstants>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- 核心依賴 - .NET Framework 4.8.1 相容套件 -->
  <ItemGroup>
    <PackageReference Include="GuerrillaNtp" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="PaddleOCRSharp" />
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="NLog" />
    <PackageReference Include="NLog.Extensions.Logging" />
  <PackageReference Include="OpenCvSharp4" />
    <!-- Phase 4 音訊與網路功能 -->
    <PackageReference Include="NAudio" />
    <PackageReference Include="Whisper.net" />
    <PackageReference Include="Downloader" />
  </ItemGroup>

  <!-- Framework 引用 -->
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <!-- 專案輸出設定 -->
  <ItemGroup>
    <None Update="app.manifest">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="NLog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 包含 Native DLL -->
    <None Include="..\..\MonLingo.Native.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>MonLingo.Native.dll</Link>
    </None>
  </ItemGroup>

  <!-- 建置後動作 -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="echo MonLingo.Core WPF 應用程式建置完成 - $(TargetPath)" />
  </Target>

</Project>
