<Window x:Class="MonLingo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MonLingo - 多語言翻譯助手" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 頂部選單列 -->
        <Menu Grid.Row="0">
            <MenuItem Header="檔案(_F)">
                <MenuItem Header="設定(_S)"/>
                <Separator/>
                <MenuItem Header="退出(_X)"/>
            </MenuItem>
            <MenuItem Header="工具(_T)">
                <MenuItem Header="截圖翻譯(_S)"/>
                <MenuItem Header="熱鍵設定(_H)"/>
            </MenuItem>
            <MenuItem Header="說明(_H)">
                <MenuItem Header="關於(_A)"/>
            </MenuItem>
        </Menu>
        
        <!-- 主要內容區域 -->
        <TabControl Grid.Row="1" Margin="5">
            <TabItem Header="翻譯">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- 原文區域 -->
                    <GroupBox Grid.Row="0" Header="原文" Margin="5">
                        <TextBox x:Name="SourceTextBox" 
                                 TextWrapping="Wrap" 
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="請輸入要翻譯的文字或使用截圖功能"/>
                    </GroupBox>
                    
                    <!-- 翻譯按鈕 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                        <Button x:Name="TranslateButton" Content="翻譯" Width="100" Height="30" Margin="5"/>
                        <Button x:Name="ScreenshotButton" Content="截圖翻譯" Width="100" Height="30" Margin="5"/>
                        <Button x:Name="ClearButton" Content="清除" Width="100" Height="30" Margin="5"/>
                    </StackPanel>
                    
                    <!-- 譯文區域 -->
                    <GroupBox Grid.Row="2" Header="譯文" Margin="5">
                        <TextBox x:Name="TranslatedTextBox" 
                                 TextWrapping="Wrap" 
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"/>
                    </GroupBox>
                </Grid>
            </TabItem>
            
            <TabItem Header="歷史記錄">
                <DataGrid x:Name="HistoryDataGrid" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="時間" Binding="{Binding Timestamp}" Width="150"/>
                        <DataGridTextColumn Header="原文" Binding="{Binding OriginalText}" Width="200"/>
                        <DataGridTextColumn Header="譯文" Binding="{Binding TranslatedText}" Width="200"/>
                        <DataGridTextColumn Header="引擎" Binding="{Binding Engine}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
        
        <!-- 狀態列 -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="就緒"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="EngineStatusTextBlock" Text="翻譯引擎: 未初始化"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
