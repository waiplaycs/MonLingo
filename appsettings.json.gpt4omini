{
  "AITranslation": {
    "Provider": "OpenAI",
    "Model": "gpt-4o-mini",
    "ApiKey": "YOUR_OPENAI_API_KEY_HERE",
    "ApiEndpoint": "https://api.openai.com/v1",
    "TimeoutSeconds": 30,
    "MaxRetries": 3,
    "Temperature": 0.3,
    "MaxTokens": 2000,
    "EnableCache": true,
    "CacheExpirationHours": 24,
    "DailyQuotaLimit": 1000,
    "EnableVerboseLogging": false
  }
}
