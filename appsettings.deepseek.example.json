{
  "AITranslation": {
    // AI 提供商選擇: "OpenAI", "DeepSeek", "Gemini"
    "Provider": "DeepSeek",
    
    // 模型選擇
    // DeepSeek: "deepseek-chat"
    // OpenAI: "gpt-4o-mini", "gpt-4o"
    // Gemini: "gemini-1.5-flash", "gemini-1.5-pro"
    "Model": "deepseek-chat",
    
    // API 密鑰 (建議使用環境變數 MONLINGO_DEEPSEEK_API_KEY)
    // 請勿提交真實密鑰到 Git!
    "ApiKey": "",
    
    // API 端點 (可選,會自動根據Provider設置)
    // DeepSeek: https://api.deepseek.com
    // OpenAI: https://api.openai.com/v1
    "ApiEndpoint": "",
    
    // 請求超時時間(秒)
    "TimeoutSeconds": 30,
    
    // 最大重試次數
    "MaxRetries": 3,
    
    // 溫度參數 (0.0-2.0)
    // 0.0-0.5: 更準確、一致 (推薦翻譯使用)
    // 0.5-1.0: 平衡
    // 1.0-2.0: 更有創造性
    "Temperature": 0.3,
    
    // 最大輸出 tokens
    "MaxTokens": 2000,
    
    // 是否啟用緩存 (減少重複調用)
    "EnableCache": true,
    
    // 緩存過期時間(小時)
    "CacheExpirationHours": 24,
    
    // 每日API調用配額限制 (0表示無限制)
    "DailyQuotaLimit": 1000,
    
    // 是否啟用詳細日誌 (調試時使用)
    "EnableVerboseLogging": false
  }
}
